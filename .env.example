# Public web origin used by native builds and App Store review links.
EXPO_PUBLIC_STUDI_WEB_BASE_URL=https://www.joinstudi.com

# Swap this to the final public support alias before App Store submission.
EXPO_PUBLIC_STUDI_SUPPORT_EMAIL=isp.studi@gmail.com
EXPO_PUBLIC_STUDI_CONTACT_EMAIL=isp.studi@gmail.com

# Analytics & observability (public client keys). Without these, analytics
# and crash reporting are silent no-ops.
EXPO_PUBLIC_POSTHOG_API_KEY=phc_replace_me
EXPO_PUBLIC_SENTRY_DSN=https://replace-me.ingest.sentry.io/0
