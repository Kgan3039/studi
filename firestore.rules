rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isVerifiedUwUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@wisc[.]edu');
    }

    function isOwner(userId) {
      return isVerifiedUwUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isBlockedEitherWay(userA, userB) {
      return exists(/databases/$(database)/documents/userBlocks/$(userA + '__' + userB))
        || exists(/databases/$(database)/documents/userBlocks/$(userB + '__' + userA));
    }

    // Post-batch block check: a block created in the SAME batch as an accept
    // must still prevent the friendship (exists() only sees pre-batch state).
    function isBlockedEitherWayAfter(userA, userB) {
      return existsAfter(/databases/$(database)/documents/userBlocks/$(userA + '__' + userB))
        || existsAfter(/databases/$(database)/documents/userBlocks/$(userB + '__' + userA));
    }

    // ---- Deterministic `{uidA}__{uidB}` pair IDs ----------------------
    // Shared by every collection keyed on a uid pair: conversations,
    // userBlocks, friendRequests, friendships.

    // A safe pair-ID component. Studi accounts are created ONLY through
    // Firebase email/password auth (no Admin createUser / importUsers / custom
    // tokens anywhere in the codebase), so every uid is a Firebase-generated
    // [A-Za-z0-9] string — it never contains `_`, `-`, or `__`. Enforcing this
    // at write makes `{a}__{b}` an unambiguous, non-empty, delimiter-free
    // encoding (mirrors functions/pair-id.js SAFE_UID_PATTERN and the client).
    function isSafeUidComponent(value) {
      return value is string && value.matches('^[A-Za-z0-9]{1,128}$');
    }

    // Membership derived from the deterministic doc ID itself, not the doc
    // body. Every pair collection keys on `{uidA}__{uidB}`, so splitting the id
    // yields the exact pair. Gating `get` on this — rather than on
    // `resource == null || <body check>` — means a missing doc and an existing
    // doc are BOTH denied to an outsider, closing the existence-probing side
    // channel (a non-member can no longer tell "missing" from "denied").
    // Malformed ids are rejected: exactly two segments, each a safe non-empty
    // uid component, and the two members must be DISTINCT (so a self-pair id
    // like `uid__uid` fails closed — no real request/friendship/conversation
    // pairs a user with themselves). So empty segments (`__x`), `>2`-part ids,
    // and self-pairs are all denied.
    function isDeterministicPairMember(docId) {
      return docId.split('__').size() == 2
        && isSafeUidComponent(docId.split('__')[0])
        && isSafeUidComponent(docId.split('__')[1])
        && docId.split('__')[0] != docId.split('__')[1]
        && request.auth.uid in docId.split('__');
    }

    function rateLimitRef(userId, action) {
      return /databases/$(database)/documents/rateLimits/$(userId)/actions/$(action);
    }

    function isKnownRateLimitedAction(action) {
      return action in ['sendMessage', 'createSession', 'reportUser', 'catalogRequest', 'locationRating',
                        'friendRequest', 'createConversation', 'updateSession'];
    }

    // Four rate-limit shapes share the rateLimits/{uid}/actions/{action} path:
    //
    //  - INTERVAL: `updatedAt` is bound to one exact resource path in
    //    `lastResourceId`.
    //  - BOUND INTERVAL (catalogRequest and friendRequest):
    //    `updatedAt` plus the exact request
    //    document id authorized by that limiter update. Binding the id prevents
    //    one atomic limiter write from authorizing multiple request creates.
    //  - STRICT BOUND RESOURCE (updateSession): every material edit requires
    //    `{ updatedAt, lastResourceId }` atomically bound to that session. This
    //    feature is unreleased, so there is no legacy unbound compatibility.
    //  - COUNTER (createConversation): a fixed 24h window with a hard cap.
    //    Unsolicited DM threads need total reach bounded, not just slowed, so
    //    an interval throttle is the wrong instrument (security audit H3).
    //
    function isCounterRateLimitedAction(action) {
      return action == 'createConversation';
    }

    function isBoundIntervalRateLimitedAction(action) {
      return action == 'catalogRequest';
    }

    function isStrictBoundResourceRateLimitedAction(action) {
      return action == 'updateSession';
    }

    // New conversation partners allowed per window. A conversation ID is the
    // deterministic sorted pair and can only ever be CREATED once (update
    // cannot touch participantIds), so counting creates counts distinct
    // counterparts exactly — no separate distinct-tracking is needed.
    // Mirrors CONVERSATION_QUOTA_MAX in lib/firestore.ts; change both together.
    function conversationQuotaMax() {
      return 10;
    }

    function conversationQuotaWindow() {
      return duration.value(24, 'h');
    }

    // The counter is unforgeable:
    //  - a new window may start ONLY when no doc exists or the stored window is
    //    genuinely older than the window length (no early reset),
    //  - a reset pins windowStart to the server clock (no backdating),
    //  - an increment must carry the SAME windowStart and exactly count + 1,
    //    capped at the max (no skipping, no rewriting history),
    //  - delete is denied outright (see the rateLimits match block).
    // Writing this doc without creating a conversation only burns the caller's
    // own quota, so there is nothing to gain by it.
    function isValidQuotaCounterWrite(userId, action) {
      return incoming().keys().hasOnly([
          'windowStart', 'count', 'lastConversationId', 'updatedAt', 'expiresAt'
        ])
        && incoming().updatedAt == request.time
        && incoming().lastConversationId is string
        && isDeterministicPairMember(incoming().lastConversationId)
        && incoming().windowStart is timestamp
        && incoming().count is int
        && incoming().count >= 1
        // TTL horizon. Bounded against the SERVER clock on both sides rather
        // than derived from windowStart, because on a reset windowStart is a
        // server sentinel the client cannot do arithmetic on. The band still
        // guarantees expiresAt lands at or after the window closes, so TTL can
        // only ever remove a doc whose window is already dead — and removing
        // one of those is behaviourally identical to the reset branch below,
        // never a way to recycle quota early.
        && incoming().expiresAt >= request.time + conversationQuotaWindow()
        && incoming().expiresAt <= request.time + duration.value(72, 'h')
        && (
          // Fresh window: first ever, or the previous one has fully expired.
          (
            (!exists(rateLimitRef(userId, action))
              || resource.data.windowStart <= request.time - conversationQuotaWindow())
            && incoming().windowStart == request.time
            && incoming().count == 1
          )
          // Increment inside a still-live window.
          || (
            exists(rateLimitRef(userId, action))
            && resource.data.windowStart > request.time - conversationQuotaWindow()
            && incoming().windowStart == resource.data.windowStart
            && incoming().count == resource.data.count + 1
            && incoming().count <= conversationQuotaMax()
          )
        );
    }

    function hasValidBoundResourceId() {
      return incoming().lastResourceId is string
        && incoming().lastResourceId.size() > 0
        && incoming().lastResourceId.size() <= 500;
    }

    function isValidIntervalRateLimitWrite(userId, action) {
      return incoming().keys().hasOnly(['updatedAt', 'lastResourceId'])
        && hasValidBoundResourceId()
        && incoming().updatedAt == request.time
        && (
          !exists(rateLimitRef(userId, action))
          || respectsRateLimit(userId, action, resource.data.updatedAt)
        );
    }

    function respectsRateLimit(userId, action, previousUpdatedAt) {
      return userId == request.auth.uid
        && (
          (action == 'sendMessage'
            && previousUpdatedAt <= request.time - duration.value(2, 's'))
          || (action == 'createSession'
            && previousUpdatedAt <= request.time - duration.value(60, 's'))
          || (action == 'reportUser'
            && previousUpdatedAt <= request.time - duration.value(10, 'm'))
          || (action == 'locationRating'
            && previousUpdatedAt <= request.time - duration.value(10, 's'))
          || (action == 'friendRequest'
            && previousUpdatedAt <= request.time - duration.value(10, 's'))
          // Material host edits can fan out to every attendee. Thirty seconds
          // permits quick corrections while bounding persistent/push spam.
          || (action == 'updateSession'
            && previousUpdatedAt <= request.time - duration.value(30, 's'))
        );
    }

    function isValidStrictBoundResourceRateLimitWrite(userId, action) {
      let parts = incoming().lastResourceId is string
        ? incoming().lastResourceId.split('/')
        : [];
      let sessionRef = parts.size() == 2
        ? /databases/$(database)/documents/sessions/$(parts[1])
        : /databases/$(database)/documents/sessions/__invalid__;
      return action == 'updateSession'
        && incoming().keys().hasOnly(['updatedAt', 'lastResourceId'])
        && incoming().updatedAt == request.time
        && hasValidBoundResourceId()
        && parts.size() == 2
        && parts[0] == 'sessions'
        && parts[1].size() > 0
        && exists(sessionRef)
        && existsAfter(sessionRef)
        && get(sessionRef).data.hostId == userId
        && getAfter(sessionRef).data.diff(get(sessionRef).data).affectedKeys().hasAny([
             'title', 'classId', 'locationId', 'startTime', 'endTime', 'capacity'
           ])
        && (
          !exists(rateLimitRef(userId, action))
          || (
            resource.data.updatedAt is timestamp
            && respectsRateLimit(userId, action, resource.data.updatedAt)
          )
        );
    }

    function isValidBoundIntervalRateLimitWrite(userId, action) {
      return action == 'catalogRequest'
        && incoming().keys().hasOnly(['updatedAt', 'lastRequestId'])
        && incoming().updatedAt == request.time
        && incoming().lastRequestId is string
        && incoming().lastRequestId.size() > 0
        && incoming().lastRequestId.size() <= 128
        && (
          !exists(rateLimitRef(userId, action))
          || (
            resource.data.updatedAt is timestamp
            && resource.data.updatedAt <= request.time - duration.value(10, 'm')
          )
        );
    }

    function isValidBoundFriendRequestId(userId) {
      return incoming().lastRequestId is string
        && incoming().lastRequestId.split('__').size() == 2
        && incoming().lastRequestId.split('__')[0] == userId
        && isSafeUidComponent(incoming().lastRequestId.split('__')[0])
        && isSafeUidComponent(incoming().lastRequestId.split('__')[1])
        && incoming().lastRequestId.split('__')[0] != incoming().lastRequestId.split('__')[1];
    }

    function isValidFriendRequestRateLimitWrite(userId) {
      return incoming().updatedAt == request.time
        && (
          !exists(rateLimitRef(userId, 'friendRequest'))
          || respectsRateLimit(userId, 'friendRequest', resource.data.updatedAt)
        )
        && incoming().keys().hasOnly(['updatedAt', 'lastRequestId'])
        && isValidBoundFriendRequestId(userId);
    }

    function isValidRateLimitWrite(userId, action) {
      return isVerifiedUwUser()
        && isKnownRateLimitedAction(action)
        && userId == request.auth.uid
        && (
          isCounterRateLimitedAction(action)
            ? isValidQuotaCounterWrite(userId, action)
            : (
              isStrictBoundResourceRateLimitedAction(action)
                ? isValidStrictBoundResourceRateLimitWrite(userId, action)
                : (
                  action == 'friendRequest'
                    ? isValidFriendRequestRateLimitWrite(userId)
                    : (
                      isBoundIntervalRateLimitedAction(action)
                        ? isValidBoundIntervalRateLimitWrite(userId, action)
                        : isValidIntervalRateLimitWrite(userId, action)
                    )
                )
            )
        );
    }

    function hasFreshRateLimit(userId, action) {
      return getAfter(rateLimitRef(userId, action)).data.updatedAt == request.time;
    }

    function hasFreshBoundRateLimit(userId, action, resourceId) {
      return getAfter(rateLimitRef(userId, action)).data.updatedAt == request.time
        && getAfter(rateLimitRef(userId, action)).data.lastResourceId == resourceId;
    }

    function hasFreshStrictBoundRateLimit(userId, action, resourceId) {
      return getAfter(rateLimitRef(userId, action)).data.updatedAt == request.time
        && getAfter(rateLimitRef(userId, action)).data.lastResourceId == resourceId;
    }

    function hasFreshCatalogRequestRateLimit(userId, requestId) {
      return getAfter(rateLimitRef(userId, 'catalogRequest')).data.updatedAt == request.time
        && getAfter(rateLimitRef(userId, 'catalogRequest')).data.lastRequestId == requestId;
    }

    function hasFreshBoundFriendRequestRateLimit(userId, requestId) {
      return getAfter(rateLimitRef(userId, 'friendRequest')).data.updatedAt == request.time
        && getAfter(rateLimitRef(userId, 'friendRequest')).data.lastRequestId == requestId;
    }

    function hasFreshConversationQuota(userId, conversationId) {
      return getAfter(rateLimitRef(userId, 'createConversation')).data.updatedAt == request.time
        && getAfter(rateLimitRef(userId, 'createConversation')).data.lastConversationId
             == conversationId;
    }

    // High-confidence launch filter. It rejects complete hostile utterances,
    // not words embedded in quoted, academic, historical, or mental-health
    // discussion. The client mirrors this exact finite whitespace/fullwidth
    // contract; reports are exempt so users can quote abuse as evidence.
    function isAllowedUserGeneratedText(value) {
      return value is string
        && !value.lower().matches(
          "^[ \\t\\r\\n 　]*[.!?]*(((go|please|you[ \\t\\r\\n 　]+should|hey,?)[ \\t\\r\\n 　]+)?kill[ \\t\\r\\n 　]+yourself|kys|i[ \\t\\r\\n 　]+(am[ \\t\\r\\n 　]+going[ \\t\\r\\n 　]+to|will)[ \\t\\r\\n 　]+kill[ \\t\\r\\n 　]+you|i('|’)(m[ \\t\\r\\n 　]+going[ \\t\\r\\n 　]+to|ll)[ \\t\\r\\n 　]+kill[ \\t\\r\\n 　]+you|nigg(er|a)s?|fagg?ots?|ｋｙｓ|ｋｉｌｌ[ \\t\\r\\n 　]+ｙｏｕｒｓｅｌｆ|ｎｉｇｇ(ｅｒ|ａ)ｓ?|ｆａｇｇ?ｏｔｓ?)[.!?]*[ \\t\\r\\n 　]*$"
        );
    }

    // Message lifecycle fields are server-clocked and preserve the first
    // version only. Sender, creation time, and every unrelated field remain
    // immutable. An unsend removes both current and original content while
    // retaining a content-free tombstone so conversation order stays intact.
    function isValidMessageEdit() {
      return request.auth.uid == resource.data.senderId
        && !('unsentAt' in resource.data)
        && request.time <= resource.data.createdAt + duration.value(15, 'm')
        && affectedKeys().hasOnly(['text', 'editedAt', 'originalText'])
        && incoming().keys().hasOnly([
             'senderId', 'text', 'createdAt', 'editedAt', 'originalText'
           ])
        && incoming().senderId == resource.data.senderId
        && incoming().createdAt == resource.data.createdAt
        && incoming().text is string
        && incoming().text.size() >= 1
        && incoming().text.size() <= 2000
        && incoming().text != resource.data.text
        && isAllowedUserGeneratedText(incoming().text)
        && incoming().editedAt == request.time
        && incoming().originalText is string
        && incoming().originalText.size() >= 1
        && incoming().originalText.size() <= 2000
        && (
          (('originalText' in resource.data)
            && incoming().originalText == resource.data.originalText)
          || (!('originalText' in resource.data)
            && incoming().originalText == resource.data.text)
        );
    }

    function isValidMessageUnsend() {
      return request.auth.uid == resource.data.senderId
        && !('unsentAt' in resource.data)
        && request.time <= resource.data.createdAt + duration.value(2, 'm')
        && affectedKeys().hasOnly(['text', 'editedAt', 'originalText', 'unsentAt'])
        && incoming().keys().hasOnly(['senderId', 'text', 'createdAt', 'unsentAt'])
        && incoming().senderId == resource.data.senderId
        && incoming().createdAt == resource.data.createdAt
        && incoming().text == ''
        && incoming().unsentAt == request.time;
    }

    // ------------------------------------------------------------------
    // Users — public profile: displayName + classes + optional academic
    // fields (year/major/pronouns/bio). Still no PII: no email, no phone,
    // no socials, no photos.
    // ------------------------------------------------------------------

    function isValidPublicProfile() {
      return incoming().keys().hasOnly([
          'displayName', 'displayNameLower', 'classes', 'year', 'major',
          'pronouns', 'bio', 'createdAt', 'updatedAt'
        ])
        && (!('displayName' in incoming()) ||
              (incoming().displayName is string
               && incoming().displayName.size() <= 60))
        && (!('displayName' in incoming()) || isAllowedUserGeneratedText(incoming().displayName))
        // displayNameLower powers case-insensitive prefix search (Firestore
        // range queries are case-sensitive, so a normalized shadow field is
        // required). Optional — legacy docs predate it — but when present it
        // must be the exact lowercase of displayName, so the two can never
        // drift once the field exists on a doc.
        && (!('displayNameLower' in incoming()) ||
              ('displayName' in incoming()
               && incoming().displayNameLower is string
               && incoming().displayNameLower == incoming().displayName.lower()))
        && (!('classes' in incoming()) ||
              (incoming().classes is list
               && incoming().classes.size() <= 12))
        // Optional fields are absent rather than empty — clients delete the
        // key instead of writing '' or null, so every present value is real.
        && (!('year' in incoming()) ||
              incoming().year in ['Freshman', 'Sophomore', 'Junior', 'Senior', 'Grad'])
        && (!('major' in incoming()) ||
              (incoming().major is string
               && incoming().major.size() >= 1
               && incoming().major.size() <= 60
               && isAllowedUserGeneratedText(incoming().major)))
        && (!('pronouns' in incoming()) ||
              (incoming().pronouns is string
               && incoming().pronouns.size() >= 1
               && incoming().pronouns.size() <= 20
               && isAllowedUserGeneratedText(incoming().pronouns)))
        && (!('bio' in incoming()) ||
              (incoming().bio is string
               && incoming().bio.size() >= 1
               && incoming().bio.size() <= 140
               && isAllowedUserGeneratedText(incoming().bio)));
    }

    // Notification preferences (users/{uid}/private/settings, PR: settings).
    // A partial map is valid — a missing doc or missing key means the
    // preference is enabled — but every present value must be a real boolean
    // and updatedAt is pinned to the server clock. No public profile data
    // belongs here.
    function isValidUserSettings() {
      return incoming().keys().hasOnly(['notificationPrefs', 'updatedAt'])
        && incoming().updatedAt == request.time
        && incoming().notificationPrefs is map
        && incoming().notificationPrefs.keys().hasOnly([
             'sessionReminders', 'sessionActivity', 'dmMessages',
             'groupMessages', 'friendRequests'
           ])
        && (!('sessionReminders' in incoming().notificationPrefs)
              || incoming().notificationPrefs.sessionReminders is bool)
        && (!('sessionActivity' in incoming().notificationPrefs)
              || incoming().notificationPrefs.sessionActivity is bool)
        && (!('dmMessages' in incoming().notificationPrefs)
              || incoming().notificationPrefs.dmMessages is bool)
        && (!('groupMessages' in incoming().notificationPrefs)
              || incoming().notificationPrefs.groupMessages is bool)
        && (!('friendRequests' in incoming().notificationPrefs)
              || incoming().notificationPrefs.friendRequests is bool);
    }

    match /users/{userId} {
      allow read: if isVerifiedUwUser();
      // displayNameLower rollout — PHASE 1 (this release): the field is
      // OPTIONAL on create and update so already-shipped clients (which don't
      // write it) keep working; when present, isValidPublicProfile pins it to
      // displayName.lower() so it can never drift. The new app always writes
      // it, and scripts/backfill-display-name-lower.mjs fills legacy docs after
      // deploy. PHASE 2 (follow-up hardening, see docs/friends-rollout.md):
      // make it mandatory on named create/rename once the minimum supported app
      // version writes it. Do NOT tighten this before that version ships.
      allow create: if isOwner(userId)
        && isValidPublicProfile()
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidPublicProfile()
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if false; // deletion handled by the deleteUserAccount Cloud Function

      // Private subcollection: owner-only. Two client-writable docs:
      //  - profile:  email mirror (must match the auth token)
      //  - settings: notification preferences
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && (
            (docId == 'profile'
              && incoming().keys().hasOnly(['email', 'updatedAt'])
              && incoming().email is string
              && incoming().email == request.auth.token.email)
            || (docId == 'settings' && isValidUserSettings())
          );
        allow delete: if false;

        match /tokens/{tokenId} {
          // Push tokens live under users/{uid}/private/pushTokens/tokens/{tokenId}
          // and are managed only by Cloud Functions/Admin SDK.
          allow read, write: if false;
        }
      }

      // Notification records (PR: notifications center) are created only by
      // Cloud Functions (Admin SDK bypasses rules). The owner may read them
      // and flip readAt exactly once: null → the server clock. Nothing else
      // changes, ever. No client dismiss in this PR, so no delete; expiry is
      // the Firestore TTL policy on expiresAt.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId)
          && affectedKeys().hasOnly(['readAt'])
          && resource.data.readAt == null
          && incoming().readAt == request.time;
        allow delete: if false;
      }

      // Chat read markers (PR: group chat) — one tiny owner-only doc per
      // thread recording when the owner last opened it; unread is derived as
      // session.lastMessageAt > lastReadAt. threadId must name a real thread
      // the owner belongs to — a session or a DM conversation — so nobody can
      // pile up junk marker docs. Pinned to the server clock so a forged
      // future marker can't hide messages that haven't arrived. Costs at most
      // two extra document reads per marker write.
      match /reads/{threadId} {
        function isOwnSessionThread() {
          return exists(/databases/$(database)/documents/sessions/$(threadId))
            && request.auth.uid in
               get(/databases/$(database)/documents/sessions/$(threadId)).data.participantIds;
        }

        function isOwnConversationThread() {
          return exists(/databases/$(database)/documents/conversations/$(threadId))
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(threadId)).data.participantIds;
        }

        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly(['lastReadAt'])
          && incoming().lastReadAt == request.time
          && (isOwnSessionThread() || isOwnConversationThread());
        allow delete: if false; // account deletion recursive-deletes the user tree
      }

      // Personal session-chat history. Removing a row only records an
      // owner-scoped timestamp; it never mutates the shared session/messages.
      // The marker remains until its owner explicitly restores the row.
      match /hiddenChats/{hiddenChatId} {
        function isOwnHiddenSession() {
          return incoming().chatType == 'group'
            && exists(/databases/$(database)/documents/sessions/$(incoming().threadId))
            && request.auth.uid in
               get(/databases/$(database)/documents/sessions/$(incoming().threadId)).data.participantIds;
        }

        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hiddenChatId == incoming().chatType + '__' + incoming().threadId
          && incoming().keys().hasOnly(['chatType', 'threadId', 'removedAt'])
          && incoming().chatType == 'group'
          && incoming().threadId is string
          && incoming().threadId.size() >= 1
          && incoming().threadId.size() <= 300
          && incoming().removedAt == request.time
          && isOwnHiddenSession();
        // Deleting the owner's marker is the explicit restore operation. There
        // is no restore UI in this beta; account deletion also removes the user
        // tree recursively through the existing Admin path.
        allow delete: if isOwner(userId);
      }

      // Per-message "Delete for Me" markers. The shared message remains
      // untouched; markers are private, owner-scoped, and nested by thread so
      // each chat subscribes only to its own deletion set.
      match /messageHides/{threadKey}/messages/{messageId} {
        function isOwnDirectMessage() {
          return incoming().threadType == 'direct'
            && exists(
              /databases/$(database)/documents/conversations/$(incoming().threadId)
            )
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(incoming().threadId)
            ).data.participantIds
            && exists(
              /databases/$(database)/documents/conversations/$(incoming().threadId)/messages/$(messageId)
            );
        }

        function isOwnSessionMessage() {
          return incoming().threadType == 'session'
            && exists(/databases/$(database)/documents/sessions/$(incoming().threadId))
            && request.auth.uid in get(
              /databases/$(database)/documents/sessions/$(incoming().threadId)
            ).data.participantIds
            && exists(
              /databases/$(database)/documents/sessions/$(incoming().threadId)/messages/$(messageId)
            );
        }

        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().hasOnly([
               'threadType', 'threadId', 'messageId', 'hiddenAt'
             ])
          && incoming().threadType in ['direct', 'session']
          && incoming().threadId is string
          && incoming().threadId.size() >= 1
          && incoming().threadId.size() <= 300
          && incoming().messageId == messageId
          && messageId.matches('^[A-Za-z0-9_-]{1,128}$')
          && threadKey == incoming().threadType + '__' + incoming().threadId
          && incoming().hiddenAt == request.time
          && (isOwnDirectMessage() || isOwnSessionMessage());
        allow delete: if isOwner(userId);
      }

      // A participant can save an ended session chat while its two-hour
      // window is open. The marker is private and makes that immutable
      // history readable after the deadline passes.
      match /keptSessionChats/{sessionId} {
        function keptSession() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/sessions/$(sessionId))
          && request.auth.uid in keptSession().participantIds
          && request.time >= keptSession().endTime
          && request.time < keptSession().endTime + duration.value(2, 'h')
          && incoming().keys().hasOnly(['sessionId', 'keptAt'])
          && incoming().sessionId == sessionId
          && incoming().keptAt == request.time;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Sessions — validated create; host-edit, join/no-op/leave update branches.
    // Times are Firestore Timestamps (PR 5 client migration).
    // ------------------------------------------------------------------

    // participantIds is a SET, not a bag: seat math counts entries
    // (app/session/[sessionId].tsx) and the group-chat fanout ceiling is judged
    // on the array length, so a duplicate entry silently consumes a seat and
    // inflates the fanout count. The subset tests in isHostEdit/isSelfJoin use
    // toSet(), which collapses duplicates — this is the check that keeps the
    // stored array honest. Enforced on the INCOMING value only, and the host
    // can always satisfy it (a host edit may only ever remove members, so a
    // deduplicated array is always a legal write).
    function hasUniqueParticipantIds(participantIds) {
      return participantIds.toSet().size() == participantIds.size();
    }

    // Hard ceiling on seats, matching MAX_GROUP_CHAT_PARTICIPANTS in
    // functions/notification-validation.js and lib/firestore.ts (change all
    // three together). Capacity already caps every session created by the
    // current client at 20; this bounds the array itself, including on legacy
    // sessions that carry no capacity field.
    function isWithinParticipantCeiling(participantIds) {
      return participantIds.size() <= 20;
    }

    // Capacity counts the host (PR: session capacity). Optional so sessions
    // created before the field existed stay valid — absent means unlimited.
    function hasValidCapacity(data) {
      return !('capacity' in data)
        || (data.capacity is int
            && data.capacity >= 2
            && data.capacity <= 20);
    }

    function isValidNewSession() {
      return incoming().keys().hasOnly([
          'classId', 'hostId', 'locationId', 'title',
          'startTime', 'endTime', 'participantIds', 'status',
          'capacity', 'createdAt', 'updatedAt'
        ])
        && hasValidCapacity(incoming())
        && incoming().hostId == request.auth.uid
        && incoming().participantIds == [request.auth.uid]
        && incoming().status == 'open'
        && incoming().classId is string
        && incoming().classId.size() >= 1 && incoming().classId.size() <= 20
        && incoming().locationId is string
        && incoming().locationId.size() >= 1 && incoming().locationId.size() <= 60
        && incoming().title is string
        && incoming().title.size() >= 1 && incoming().title.size() <= 80
        && isAllowedUserGeneratedText(incoming().title)
        && incoming().startTime is timestamp
        && incoming().endTime is timestamp
        && incoming().startTime > request.time
        && incoming().endTime > incoming().startTime
        && incoming().startTime < request.time + duration.value(31, 'd')
        && incoming().endTime < incoming().startTime + duration.value(12, 'h')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function sessionOwnerPinned() {
      return incoming().hostId == resource.data.hostId
        && incoming().createdAt == resource.data.createdAt;
    }

    function sessionIdentityPinned() {
      return sessionOwnerPinned()
        && incoming().classId == resource.data.classId;
    }

    function isMaterialSessionEdit() {
      return affectedKeys().hasAny([
        'title', 'classId', 'locationId', 'startTime', 'endTime', 'capacity'
      ]);
    }

    function isHostEdit(sessionId) {
      return request.auth.uid == resource.data.hostId
        && sessionOwnerPinned()
        && affectedKeys().hasOnly(['title', 'locationId', 'startTime', 'endTime',
                                   'status', 'participantIds', 'capacity', 'classId',
                                   'updatedAt'])
        && incoming().updatedAt == request.time
        && hasValidCapacity(incoming())
        // Duplicate padding was the one way a host could grow participantIds
        // past the subset test below (duplicates of a seated member collapse in
        // toSet()). Always enforced — a deduplicated array is always writable.
        && hasUniqueParticipantIds(incoming().participantIds)
        // Never grow past the ceiling. The second arm keeps an oversized legacy
        // session editable at all: its host can still retitle, reschedule,
        // cancel, and kick without first having to remove people, because the
        // subset test already makes growth in MEMBERS impossible.
        && (isWithinParticipantCeiling(incoming().participantIds)
            || incoming().participantIds.size() <= resource.data.participantIds.size())
        // Host may loosen but never shrink below the people already seated
        // (post-state count, so a simultaneous kick + reduce is judged fairly):
        && (!('capacity' in incoming())
            || incoming().capacity >= incoming().participantIds.size())
        && resource.data.hostId in incoming().participantIds
        && incoming().status in ['open', 'full', 'cancelled']
        && incoming().title is string && incoming().title.size() >= 1
        && incoming().title.size() <= 80
        && isAllowedUserGeneratedText(incoming().title)
        && incoming().classId is string
        && incoming().classId.size() >= 1 && incoming().classId.size() <= 20
        && incoming().locationId is string
        && incoming().locationId.size() >= 1 && incoming().locationId.size() <= 60
        && incoming().startTime is timestamp
        && incoming().endTime is timestamp
        && incoming().endTime > incoming().startTime
        && incoming().endTime < incoming().startTime + duration.value(12, 'h')
        // Rescheduling must land in the same future window as create; leaving
        // startTime untouched keeps cancel/kick possible on in-progress sessions.
        && (incoming().startTime == resource.data.startTime
            || (incoming().startTime > request.time
                && incoming().startTime < request.time + duration.value(31, 'd')))
        // Host may only REMOVE participants (kick), never inject anyone:
        && incoming().participantIds.toSet().intersection(
             resource.data.participantIds.toSet()
           ) == incoming().participantIds.toSet()
        && (!isMaterialSessionEdit()
            || hasFreshStrictBoundRateLimit(
                 request.auth.uid, 'updateSession', 'sessions/' + sessionId
               ));
    }

    function isSelfJoin() {
      return sessionIdentityPinned()
        && affectedKeys().hasOnly(['participantIds', 'updatedAt'])
        && resource.data.status == 'open'
        && resource.data.startTime > request.time
        && !(request.auth.uid in resource.data.participantIds)
        && request.auth.uid in incoming().participantIds
        && incoming().participantIds.size() == resource.data.participantIds.size() + 1
        && incoming().participantIds.toSet().intersection(
             resource.data.participantIds.toSet()
           ) == resource.data.participantIds.toSet()
        // Seats stay a bounded, duplicate-free set. Capacity already caps every
        // session the current client creates; this also bounds joins on legacy
        // sessions that carry no capacity field, where the array was otherwise
        // free to grow without limit.
        && hasUniqueParticipantIds(incoming().participantIds)
        && isWithinParticipantCeiling(incoming().participantIds)
        // Capacity is the seat ceiling (host included). Legacy sessions
        // without the field stay unlimited. This is the final enforcement
        // layer behind the client's transactional join.
        && (!('capacity' in resource.data)
            || incoming().participantIds.size() <= resource.data.capacity)
        && !isBlockedEitherWay(request.auth.uid, resource.data.hostId);
    }

    function isSelfJoinNoOp() {
      // Tolerates double-tap joins (arrayUnion no-op) instead of erroring.
      return affectedKeys().hasOnly(['updatedAt'])
        && request.auth.uid in resource.data.participantIds;
    }

    function isSelfLeave() {
      return sessionIdentityPinned()
        && request.auth.uid != resource.data.hostId
        && affectedKeys().hasOnly(['participantIds', 'updatedAt'])
        && request.auth.uid in resource.data.participantIds
        && !(request.auth.uid in incoming().participantIds)
        // The post-state must be EXACTLY the prior roster minus the caller.
        // The previous formulation — a size drop of exactly one plus a subset
        // test — let a leaver evict someone else by padding a duplicate into
        // the gap they freed: [alice, bob, mallory] → [alice, alice] satisfied
        // both checks (size 3-1, and {alice} is a subset of the old roster)
        // while silently removing bob.
        //
        // The two clauses below are load-bearing for DIFFERENT reasons —
        // neither is redundant:
        //  - Set equality closes the eviction hole. A post-state whose set is
        //    exactly `old minus caller` still holds every other member by
        //    construction, so no one can be substituted out.
        //  - Uniqueness bounds the array. There is no ceiling check on this
        //    branch; length stays bounded only because a duplicate-free array
        //    over a pinned set holds at most |old set| - 1 entries. Without it
        //    [alice x500, bob] satisfies set equality and grows the roster
        //    without limit.
        //
        // The old size test is subsumed by set equality for a duplicate-free
        // roster. On a roster that already CONTAINS duplicates — reachable only
        // from the host-padding hole closed alongside this, i.e. docs written
        // before that deploy — the rules do accept a deduplicated leave, but
        // leaveSession in lib/firestore.ts uses arrayRemove, which strips only
        // the caller's copies and preserves everyone else's. So through the app
        // such a member cannot leave until the roster is deduplicated. Confirm
        // no duplicate rosters exist rather than assuming; do not read this
        // clause as a guarantee that they stay leavable end-to-end.
        && hasUniqueParticipantIds(incoming().participantIds)
        && incoming().participantIds.toSet() ==
             resource.data.participantIds.toSet().difference([request.auth.uid].toSet());
    }

    match /sessions/{sessionId} {
      allow read: if isVerifiedUwUser();
      allow create: if isVerifiedUwUser()
        && isValidNewSession()
        && hasFreshBoundRateLimit(
             request.auth.uid, 'createSession', 'sessions/' + sessionId
           );
      allow update: if isVerifiedUwUser()
        && (isHostEdit(sessionId) || isSelfJoin() || isSelfJoinNoOp() || isSelfLeave());
      // Hosts cancel sessions. Permanent recursive cleanup is Admin-only via
      // the resumable account-deletion runner.
      allow delete: if false;

      // Session group chat (PR: group chat) — participant-gated via the
      // parent session doc, message shape identical to DM messages. The
      // lastMessageAt/lastMessageSenderId unread metadata on the session doc
      // is written only by the Cloud Function (Admin SDK bypasses rules);
      // no client update branch exists for it. Leaving the session ends
      // access. A cancelled session is read-only: retained participants keep
      // the history, nobody sends. After the two-hour post-session grace
      // window, only participants who saved their copy can read it. Sends end
      // with that same grace window. Sends are also denied when the session
      // holds more than 20 people — the group-chat fanout ceiling, judged on
      // the ACTUAL participant count so legacy uncapped sessions can't force
      // unbounded notification fanout (mirrors MAX_GROUP_CHAT_PARTICIPANTS
      // in functions/notification-validation.js and lib/firestore.ts; change
      // all three together). Sender edits and unsends are the only client
      // updates; their windows and immutable fields are enforced below.
      match /messages/{messageId} {
        function parentSession() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }

        allow read: if isVerifiedUwUser()
          && request.auth.uid in parentSession().participantIds
          && (
            request.time < parentSession().endTime + duration.value(2, 'h')
            || exists(
              /databases/$(database)/documents/users/$(request.auth.uid)/keptSessionChats/$(sessionId)
            )
          );
        allow create: if isVerifiedUwUser()
          && request.auth.uid == incoming().senderId
          && parentSession().status in ['open', 'full']
          && request.auth.uid in parentSession().participantIds
          && request.time < parentSession().endTime + duration.value(2, 'h')
          && parentSession().participantIds.size() <= 20
          && incoming().keys().hasOnly(['senderId', 'text', 'createdAt'])
          && incoming().text is string
          && incoming().text.size() >= 1
          && incoming().text.size() <= 2000
          && isAllowedUserGeneratedText(incoming().text)
          && incoming().createdAt == request.time
          && hasFreshBoundRateLimit(
               request.auth.uid,
               'sendMessage',
               'sessions/' + sessionId + '/messages/' + messageId
             );
        allow update: if isVerifiedUwUser()
          && request.auth.uid in parentSession().participantIds
          && parentSession().status in ['open', 'full']
          && request.time < parentSession().endTime + duration.value(2, 'h')
          && parentSession().participantIds.size() <= 20
          && (isValidMessageEdit() || isValidMessageUnsend());
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Conversations — deterministic ID == participantKey, exactly 2 people,
    // blocks enforced at create AND per message.
    // ------------------------------------------------------------------

    // The participant who is not the caller. Safe because isValidNewConversation
    // has already pinned the list to exactly two entries containing the caller.
    function conversationCounterpart() {
      return incoming().participantIds[0] == request.auth.uid
        ? incoming().participantIds[1]
        : incoming().participantIds[0];
    }

    function isValidNewConversation(conversationId) {
      return incoming().keys().hasOnly([
          'participantIds', 'participantKey',
          'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && incoming().participantIds is list
        && incoming().participantIds.size() == 2
        && incoming().participantIds[0] is string
        && incoming().participantIds[1] is string
        && incoming().participantIds[0] < incoming().participantIds[1]
        && request.auth.uid in incoming().participantIds
        && incoming().participantKey ==
             incoming().participantIds[0] + '__' + incoming().participantIds[1]
        && conversationId == incoming().participantKey
        && incoming().lastMessagePreview is string
        && incoming().lastMessagePreview.size() <= 200
        // Pin all timestamps to the server clock (matches the update branch);
        // otherwise a forged lastMessageAt can park a thread atop the
        // counterpart's inbox forever.
        && incoming().lastMessageAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        // Threads only open against real accounts — no junk docs parked at
        // made-up uids, matching the friendRequests standard.
        && exists(/databases/$(database)/documents/users/$(conversationCounterpart()))
        && !isBlockedEitherWay(incoming().participantIds[0], incoming().participantIds[1]);
    }

    match /conversations/{conversationId} {
      // Membership by deterministic id, exactly like friendRequests and
      // friendships: getOrCreateDirectConversation probes `{sorted}` before it
      // knows whether the thread exists, so a participant's get must be allowed
      // on a missing doc. Gating on the id rather than on `!exists() ||
      // <body check>` means an OUTSIDER is denied identically whether the
      // thread exists or not — the previous form let a non-participant tell
      // "missing" (allowed, empty snapshot) from "exists" (permission-denied),
      // an oracle over who has DMed whom across the whole user base.
      allow get: if isVerifiedUwUser()
        && isDeterministicPairMember(conversationId);
      allow list: if isVerifiedUwUser()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isVerifiedUwUser()
        && isValidNewConversation(conversationId)
        && hasFreshConversationQuota(request.auth.uid, conversationId);
      // Direct-message metadata is derived from the persisted message by the
      // Admin SDK trigger. Clients cannot forge inbox previews or timestamps.
      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isVerifiedUwUser()
          && request.auth.uid in parentConversation().participantIds;
        allow create: if isVerifiedUwUser()
          && request.auth.uid == incoming().senderId
          && request.auth.uid in parentConversation().participantIds
          && incoming().keys().hasOnly(['senderId', 'text', 'createdAt'])
          && incoming().text is string
          && incoming().text.size() >= 1
          && incoming().text.size() <= 2000
          && isAllowedUserGeneratedText(incoming().text)
          && incoming().createdAt == request.time
          && hasFreshBoundRateLimit(
               request.auth.uid,
               'sendMessage',
               'conversations/' + conversationId + '/messages/' + messageId
             )
          && !isBlockedEitherWay(
               parentConversation().participantIds[0],
               parentConversation().participantIds[1]
             );
        allow update: if isVerifiedUwUser()
          && request.auth.uid in parentConversation().participantIds
          && (
            isValidMessageUnsend()
            || (isValidMessageEdit()
              && !isBlockedEitherWay(
                   parentConversation().participantIds[0],
                   parentConversation().participantIds[1]
                 ))
          );
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Locations — curated, console-managed, read-only.
    // ------------------------------------------------------------------

    match /locations/{locationId} {
      // Curated public data (also bundled in the app binary) — readable by any
      // signed-in user, including pre-verification. Matches the pre-rewrite
      // behavior; verification gates stay on the sensitive collections.
      allow read: if request.auth != null;
      allow write: if false; // aggregates written by Cloud Function (admin bypasses rules)
    }

    // ------------------------------------------------------------------
    // Location ratings — unchanged validation standard, verified-only.
    // ------------------------------------------------------------------

    function hasValidLocationRating(ratingId) {
      return incoming().keys().hasOnly([
          'locationId', 'userId', 'stars', 'tags', 'createdAt', 'updatedAt'
        ])
        && incoming().userId == request.auth.uid
        && incoming().locationId is string
        && ratingId == incoming().locationId + '__' + request.auth.uid
        && incoming().stars is int
        && incoming().stars >= 1
        && incoming().stars <= 5
        && incoming().tags is list
        && incoming().tags.size() <= 16
        && incoming().tags.hasOnly([
          'Quiet', 'Loud', 'Crowded', 'Spacious', 'Group Friendly', 'Solo Focused',
          'Reservable Rooms', 'Good WiFi', 'Poor WiFi', 'Outlets Available',
          'Natural Light', 'Open Late', 'Food Nearby', 'Comfortable',
          'Cold Inside', 'Warm Inside'
        ]);
    }

    match /locationRatings/{ratingId} {
      // Missing owner gets must remain possible for the edit/create screen, so
      // get authorization is derived from the deterministic path. Queries are
      // authorized only when every returned document belongs to the caller.
      allow get: if isVerifiedUwUser()
        && ratingId.split('__').size() == 2
        && ratingId.split('__')[1] == request.auth.uid;
      allow list: if isVerifiedUwUser()
        && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUwUser()
        && hasValidLocationRating(ratingId)
        && hasFreshBoundRateLimit(
             request.auth.uid, 'locationRating', 'locationRatings/' + ratingId
           );
      allow update: if isVerifiedUwUser()
        && hasValidLocationRating(ratingId)
        && incoming().createdAt == resource.data.createdAt
        && hasFreshBoundRateLimit(
             request.auth.uid, 'locationRating', 'locationRatings/' + ratingId
           );
      allow delete: if isVerifiedUwUser() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Account-deletion job markers — durable deletion intent + resumable
    // progress, written ONLY by the Admin SDK (deleteUserAccount callable
    // and scripts/resume-account-deletion.js). The default deny would
    // already cover this; the explicit match documents the invariant and
    // the tests pin it.
    // ------------------------------------------------------------------

    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    // Global token-hash ownership registry. Cloud Functions atomically move a
    // physical Expo token between accounts; clients never inspect or mutate it.
    match /pushTokenOwners/{tokenHash} {
      allow read, write: if false;
    }

    // Per-installation current-token registry. Random installation IDs are
    // not device identifiers and remain Admin-only like token ownership.
    match /pushTokenInstallations/{installationHash} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Rate limits — per-user action timestamps advanced atomically with
    // abuse-prone writes. No client reads needed.
    // ------------------------------------------------------------------

    match /rateLimits/{userId}/actions/{action} {
      // Read is owner-only AND scoped to the single action that needs it. The
      // createConversation counter must be readable because the client reads
      // its own quota inside the creation transaction to decide
      // reset-vs-increment, and reads it again after a denial to tell "quota
      // spent" from "blocked"/"no such user" so it can show the right message
      // instead of a generic failure. Reading your own conversation counter
      // reveals nothing you did not already do.
      //
      // The friendRequest limiter is also owner-readable during the rollout so
      // a restarted client can distinguish a real active cooldown from other
      // permission failures. The remaining interval actions stay fully denied.
      allow read: if isOwner(userId)
        && (
          isCounterRateLimitedAction(action)
          || isBoundIntervalRateLimitedAction(action)
          || action == 'friendRequest'
        );
      allow create, update: if isValidRateLimitWrite(userId, action);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // User blocks — blocker-only visibility (D5). Deterministic ID.
    // ------------------------------------------------------------------

    match /userBlocks/{blockId} {
      // Either side of a block may `get` the single doc naming them — the
      // blocked side needs it to render conversation state — but only the
      // blocker may list, so nobody can enumerate who blocked them.
      allow get: if isVerifiedUwUser()
        && request.auth.uid in blockId.split('__');
      allow list: if isVerifiedUwUser()
        && resource.data.blockerUserId == request.auth.uid;
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly(['blockerUserId', 'blockedUserId', 'createdAt'])
        && incoming().blockerUserId == request.auth.uid
        && incoming().blockedUserId is string
        && incoming().blockedUserId != request.auth.uid
        // Keeps `{blocker}__{blocked}` an unambiguous two-segment id, matching
        // friendRequests/friendships. Without it a `__`-bearing blockedUserId
        // mints a 3-segment doc that no isBlockedEitherWay lookup can ever
        // match — an inert doc masquerading as a block.
        && isSafeUidComponent(incoming().blockedUserId)
        && blockId == incoming().blockerUserId + '__' + incoming().blockedUserId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUwUser()
        && resource.data.blockerUserId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Reports — write-only evidence. Immutable. No client reads.
    // ------------------------------------------------------------------

    match /reports/{reportId} {
      function isSafeContentId(value) {
        return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
      }

      function directMessageReportIsAuthentic() {
        let conversation = get(
          /databases/$(database)/documents/conversations/$(incoming().threadId)
        ).data;
        let message = get(
          /databases/$(database)/documents/conversations/$(incoming().threadId)/messages/$(incoming().contentId)
        ).data;
        return isDeterministicPairMember(incoming().threadId)
          && request.auth.uid in conversation.participantIds
          && message.senderId == incoming().reportedUserId
          && message.text == incoming().messageText;
      }

      function sessionMessageReportIsAuthentic() {
        let session = get(
          /databases/$(database)/documents/sessions/$(incoming().threadId)
        ).data;
        let message = get(
          /databases/$(database)/documents/sessions/$(incoming().threadId)/messages/$(incoming().contentId)
        ).data;
        return request.auth.uid in session.participantIds
          && (
            request.time < session.endTime + duration.value(2, 'h')
            || exists(
              /databases/$(database)/documents/users/$(request.auth.uid)/keptSessionChats/$(incoming().threadId)
            )
          )
          && message.senderId == incoming().reportedUserId
          && message.text == incoming().messageText;
      }

      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly([
             'reporterUserId', 'reportedUserId', 'reason', 'details',
             'context', 'contentType', 'contentId', 'threadId', 'messageText', 'createdAt'
           ])
        && incoming().reporterUserId == request.auth.uid
        && incoming().reportedUserId is string
        && incoming().reportedUserId != request.auth.uid
        && incoming().reason in ['Spam', 'Harassment', 'Unsafe behavior', 'Impersonation', 'Other']
        && incoming().details is string
        && incoming().details.size() <= 1000
        && incoming().context is string
        && incoming().context.size() <= 40
        && (!('contentType' in incoming()) || (
             incoming().contentType in ['direct_message', 'session_message']
             && isSafeContentId(incoming().contentId)
             && incoming().threadId is string
             && incoming().threadId.size() >= 1
             && incoming().threadId.size() <= 128
             && incoming().messageText is string
             && incoming().messageText.size() >= 1
             && incoming().messageText.size() <= 2000
             && (
               (incoming().contentType == 'direct_message'
                 && directMessageReportIsAuthentic())
               || (incoming().contentType == 'session_message'
                 && isSafeContentId(incoming().threadId)
                 && sessionMessageReportIsAuthentic())
             )
           ))
        && (('contentType' in incoming())
             || (!('contentId' in incoming())
               && !('threadId' in incoming())
               && !('messageText' in incoming())))
        && incoming().createdAt == request.time
        && hasFreshBoundRateLimit(
             request.auth.uid, 'reportUser', 'reports/' + reportId
           );
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Catalog requests — write-only suggestions for missing courses/spots.
    // The admin console or Admin SDK is the only review surface.
    // ------------------------------------------------------------------

    match /catalogRequests/{requestId} {
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly([
             'requesterUserId', 'type', 'name', 'searchQuery', 'building',
             'details', 'source', 'createdAt'
           ])
        && incoming().requesterUserId == request.auth.uid
        && incoming().type in ['course', 'location']
        && incoming().name is string
        && incoming().name.size() >= 2
        && incoming().name.size() <= 120
        && incoming().searchQuery is string
        && incoming().searchQuery.size() <= 120
        && (!('building' in incoming())
          || (incoming().building is string && incoming().building.size() <= 120))
        && incoming().details is string
        && incoming().details.size() <= 500
        && incoming().source is string
        && incoming().source.size() <= 40
        && incoming().createdAt == request.time
        && hasFreshCatalogRequestRateLimit(request.auth.uid, requestId);
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Friend requests — friendRequests/{fromUid}__{toUid} (PR 6). The doc's
    // existence IS the pending state: create = send, delete by sender =
    // cancel, delete by recipient = decline (or the accept batch below).
    // Deterministic IDs make duplicates structurally impossible (a resend is
    // an update, and update is denied), and the reverse-direction exists()
    // check stops mutual pending pairs. Only the two involved users can
    // read a request — nobody can enumerate someone else's social graph.
    // ------------------------------------------------------------------

    function friendRequestRef(fromUid, toUid) {
      return /databases/$(database)/documents/friendRequests/$(fromUid + '__' + toUid);
    }

    function friendshipRef(userA, userB) {
      return userA < userB
        ? /databases/$(database)/documents/friendships/$(userA + '__' + userB)
        : /databases/$(database)/documents/friendships/$(userB + '__' + userA);
    }

    match /friendRequests/{requestId} {
      // Involved-party only, by id membership — so getFriendStatus can probe a
      // request that may not exist (returns exists=false) without leaking to
      // outsiders whether any given pair has one.
      allow get: if isVerifiedUwUser()
        && isDeterministicPairMember(requestId);
      allow list: if isVerifiedUwUser()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        );
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly(['fromUid', 'toUid', 'createdAt'])
        && incoming().fromUid == request.auth.uid
        && incoming().toUid is string
        && incoming().toUid != request.auth.uid
        // Both components must be safe uids so the `__` id is unambiguous.
        && isSafeUidComponent(incoming().fromUid)
        && isSafeUidComponent(incoming().toUid)
        && requestId == incoming().fromUid + '__' + incoming().toUid
        && incoming().createdAt == request.time
        // Requests only go to real accounts — no junk docs at made-up uids.
        && exists(/databases/$(database)/documents/users/$(incoming().toUid))
        // No reverse duplicate: if they already asked you, accept instead.
        && !exists(friendRequestRef(incoming().toUid, incoming().fromUid))
        // Already friends — nothing to request.
        && !exists(friendshipRef(incoming().fromUid, incoming().toUid))
        && !isBlockedEitherWay(incoming().fromUid, incoming().toUid)
        && hasFreshBoundFriendRequestRateLimit(request.auth.uid, requestId);
      allow update: if false;
      // Sender cancels; recipient declines (or deletes as part of accepting).
      allow delete: if isVerifiedUwUser()
        && request.auth.uid in [resource.data.fromUid, resource.data.toUid];
    }

    // ------------------------------------------------------------------
    // Friendships — friendships/{sortedUidA}__{sortedUidB} (PR 6). Created
    // ONLY by the request recipient, atomically with the request deletion:
    // the incoming request must exist before this batch and be gone after it
    // (existsAfter), so a friendship can never appear while its request
    // survives, and a bare create with no request is impossible. The sender
    // structurally cannot self-accept — the required doc is {other}__{me},
    // and the sender only ever holds {me}__{other}.
    // ------------------------------------------------------------------

    match /friendships/{pairId} {
      // otherMember(): the friendship member who is not the caller.
      function otherMember() {
        return incoming().userIds[0] == request.auth.uid
          ? incoming().userIds[1]
          : incoming().userIds[0];
      }

      // Member only, by id membership (getFriendStatus probes the sorted-pair
      // id before it knows whether a friendship exists) — a missing doc and an
      // existing one are alike denied to outsiders, so neither reveals the
      // friendship's existence.
      allow get: if isVerifiedUwUser()
        && isDeterministicPairMember(pairId);
      allow list: if isVerifiedUwUser()
        && request.auth.uid in resource.data.userIds;
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly(['userIds', 'acceptedBy', 'createdAt'])
        && incoming().userIds is list
        && incoming().userIds.size() == 2
        // Safe uid components make the sorted `__` pair id unambiguous.
        && isSafeUidComponent(incoming().userIds[0])
        && isSafeUidComponent(incoming().userIds[1])
        && incoming().userIds[0] < incoming().userIds[1]
        && request.auth.uid in incoming().userIds
        && pairId == incoming().userIds[0] + '__' + incoming().userIds[1]
        && incoming().acceptedBy == request.auth.uid
        && incoming().createdAt == request.time
        // Accept is atomic: the incoming request existed before the batch…
        && exists(friendRequestRef(otherMember(), request.auth.uid))
        // …and the same batch deletes it.
        && !existsAfter(friendRequestRef(otherMember(), request.auth.uid))
        // No block in either direction, judged BOTH before and after the
        // batch — so a recipient can't create a block and the friendship in
        // one batch (exists() alone would miss the same-batch block write).
        && !isBlockedEitherWay(incoming().userIds[0], incoming().userIds[1])
        && !isBlockedEitherWayAfter(incoming().userIds[0], incoming().userIds[1]);
      allow update: if false;
      // Either friend may end the friendship.
      allow delete: if isVerifiedUwUser()
        && request.auth.uid in resource.data.userIds;
    }

    // ------------------------------------------------------------------
    // Default deny.
    // ------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
