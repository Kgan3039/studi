rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isVerifiedUwUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@wisc[.]edu');
    }

    function isOwner(userId) {
      return isVerifiedUwUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isBlockedEitherWay(userA, userB) {
      return exists(/databases/$(database)/documents/userBlocks/$(userA + '__' + userB))
        || exists(/databases/$(database)/documents/userBlocks/$(userB + '__' + userA));
    }

    // ------------------------------------------------------------------
    // Users — public profile: displayName + classes only. No PII.
    // ------------------------------------------------------------------

    function isValidPublicProfile() {
      return incoming().keys().hasOnly(['displayName', 'classes', 'createdAt', 'updatedAt'])
        && (!('displayName' in incoming()) ||
              (incoming().displayName is string
               && incoming().displayName.size() <= 60))
        && (!('classes' in incoming()) ||
              (incoming().classes is list
               && incoming().classes.size() <= 12));
    }

    match /users/{userId} {
      allow read: if isVerifiedUwUser();
      allow create: if isOwner(userId)
        && isValidPublicProfile()
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidPublicProfile()
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if false; // deletion handled by the deleteUserAccount Cloud Function

      // Private profile: owner-only. Email must match the auth token.
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && docId == 'profile'
          && incoming().keys().hasOnly(['email', 'updatedAt'])
          && incoming().email is string
          && incoming().email == request.auth.token.email;
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Sessions — validated create; host/join/no-op/leave update branches.
    // Times are Firestore Timestamps (PR 5 client migration).
    // ------------------------------------------------------------------

    function isValidNewSession() {
      return incoming().keys().hasOnly([
          'classId', 'hostId', 'locationId', 'title',
          'startTime', 'endTime', 'participantIds', 'status',
          'createdAt', 'updatedAt'
        ])
        && incoming().hostId == request.auth.uid
        && incoming().participantIds == [request.auth.uid]
        && incoming().status == 'open'
        && incoming().classId is string
        && incoming().classId.size() >= 1 && incoming().classId.size() <= 20
        && incoming().locationId is string
        && incoming().locationId.size() >= 1 && incoming().locationId.size() <= 60
        && incoming().title is string
        && incoming().title.size() >= 1 && incoming().title.size() <= 80
        && incoming().startTime is timestamp
        && incoming().endTime is timestamp
        && incoming().startTime > request.time
        && incoming().endTime > incoming().startTime
        && incoming().startTime < request.time + duration.value(31, 'd')
        && incoming().endTime < incoming().startTime + duration.value(12, 'h')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function sessionIdentityPinned() {
      return incoming().hostId == resource.data.hostId
        && incoming().createdAt == resource.data.createdAt
        && incoming().classId == resource.data.classId;
    }

    function isHostEdit() {
      return request.auth.uid == resource.data.hostId
        && sessionIdentityPinned()
        && affectedKeys().hasOnly(['title', 'locationId', 'startTime', 'endTime',
                                   'status', 'participantIds', 'updatedAt'])
        && incoming().status in ['open', 'full', 'cancelled']
        && incoming().title is string && incoming().title.size() >= 1
        && incoming().title.size() <= 80
        // Host may only REMOVE participants (kick), never inject anyone:
        && incoming().participantIds.toSet().intersection(
             resource.data.participantIds.toSet()
           ) == incoming().participantIds.toSet();
    }

    function isSelfJoin() {
      return sessionIdentityPinned()
        && affectedKeys().hasOnly(['participantIds', 'updatedAt'])
        && resource.data.status == 'open'
        && resource.data.startTime > request.time
        && !(request.auth.uid in resource.data.participantIds)
        && request.auth.uid in incoming().participantIds
        && incoming().participantIds.size() == resource.data.participantIds.size() + 1
        && incoming().participantIds.toSet().intersection(
             resource.data.participantIds.toSet()
           ) == resource.data.participantIds.toSet()
        && !isBlockedEitherWay(request.auth.uid, resource.data.hostId);
    }

    function isSelfJoinNoOp() {
      // Tolerates double-tap joins (arrayUnion no-op) instead of erroring.
      return affectedKeys().hasOnly(['updatedAt'])
        && request.auth.uid in resource.data.participantIds;
    }

    function isSelfLeave() {
      return sessionIdentityPinned()
        && affectedKeys().hasOnly(['participantIds', 'updatedAt'])
        && request.auth.uid in resource.data.participantIds
        && !(request.auth.uid in incoming().participantIds)
        && incoming().participantIds.size() == resource.data.participantIds.size() - 1
        && resource.data.participantIds.toSet().intersection(
             incoming().participantIds.toSet()
           ) == incoming().participantIds.toSet();
    }

    match /sessions/{sessionId} {
      allow read: if isVerifiedUwUser();
      allow create: if isVerifiedUwUser() && isValidNewSession();
      allow update: if isVerifiedUwUser()
        && (isHostEdit() || isSelfJoin() || isSelfJoinNoOp() || isSelfLeave());
      allow delete: if isVerifiedUwUser() && request.auth.uid == resource.data.hostId;
    }

    // ------------------------------------------------------------------
    // Conversations — deterministic ID == participantKey, exactly 2 people,
    // blocks enforced at create AND per message.
    // ------------------------------------------------------------------

    function isValidNewConversation(conversationId) {
      return incoming().keys().hasOnly([
          'participantIds', 'participantKey',
          'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && incoming().participantIds is list
        && incoming().participantIds.size() == 2
        && incoming().participantIds[0] is string
        && incoming().participantIds[1] is string
        && incoming().participantIds[0] < incoming().participantIds[1]
        && request.auth.uid in incoming().participantIds
        && incoming().participantKey ==
             incoming().participantIds[0] + '__' + incoming().participantIds[1]
        && conversationId == incoming().participantKey
        && incoming().lastMessagePreview is string
        && incoming().lastMessagePreview.size() <= 200
        && !isBlockedEitherWay(incoming().participantIds[0], incoming().participantIds[1]);
    }

    function otherParticipant() {
      return resource.data.participantIds[0] == request.auth.uid
        ? resource.data.participantIds[1]
        : resource.data.participantIds[0];
    }

    match /conversations/{conversationId} {
      allow read: if isVerifiedUwUser()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isVerifiedUwUser() && isValidNewConversation(conversationId);
      allow update: if isVerifiedUwUser()
        && request.auth.uid in resource.data.participantIds
        && affectedKeys().hasOnly(['lastMessagePreview', 'lastMessageAt', 'updatedAt'])
        && incoming().lastMessagePreview is string
        && incoming().lastMessagePreview.size() <= 200;
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isVerifiedUwUser()
          && request.auth.uid in parentConversation().participantIds;
        allow create: if isVerifiedUwUser()
          && request.auth.uid == incoming().senderId
          && request.auth.uid in parentConversation().participantIds
          && incoming().keys().hasOnly(['senderId', 'text', 'createdAt'])
          && incoming().text is string
          && incoming().text.size() >= 1
          && incoming().text.size() <= 2000
          && incoming().createdAt == request.time
          && !isBlockedEitherWay(
               parentConversation().participantIds[0],
               parentConversation().participantIds[1]
             );
        allow update: if false;
        allow delete: if isVerifiedUwUser() && request.auth.uid == resource.data.senderId;
      }
    }

    // ------------------------------------------------------------------
    // Locations — curated, console-managed, read-only.
    // ------------------------------------------------------------------

    match /locations/{locationId} {
      // Curated public data (also bundled in the app binary) — readable by any
      // signed-in user, including pre-verification. Matches the pre-rewrite
      // behavior; verification gates stay on the sensitive collections.
      allow read: if request.auth != null;
      allow write: if false; // aggregates written by Cloud Function (admin bypasses rules)
    }

    // ------------------------------------------------------------------
    // Location ratings — unchanged validation standard, verified-only.
    // ------------------------------------------------------------------

    function hasValidLocationRating(ratingId) {
      return incoming().keys().hasOnly([
          'locationId', 'userId', 'stars', 'tags', 'createdAt', 'updatedAt'
        ])
        && incoming().userId == request.auth.uid
        && incoming().locationId is string
        && ratingId == incoming().locationId + '__' + request.auth.uid
        && incoming().stars is int
        && incoming().stars >= 1
        && incoming().stars <= 5
        && incoming().tags is list
        && incoming().tags.size() <= 16
        && incoming().tags.hasOnly([
          'Quiet', 'Loud', 'Crowded', 'Spacious', 'Group Friendly', 'Solo Focused',
          'Reservable Rooms', 'Good WiFi', 'Poor WiFi', 'Outlets Available',
          'Natural Light', 'Open Late', 'Food Nearby', 'Comfortable',
          'Cold Inside', 'Warm Inside'
        ]);
    }

    match /locationRatings/{ratingId} {
      allow read: if isVerifiedUwUser();
      allow create: if isVerifiedUwUser() && hasValidLocationRating(ratingId);
      allow update: if isVerifiedUwUser()
        && hasValidLocationRating(ratingId)
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if isVerifiedUwUser() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // User blocks — blocker-only visibility (D5). Deterministic ID.
    // ------------------------------------------------------------------

    match /userBlocks/{blockId} {
      allow read: if isVerifiedUwUser()
        && resource.data.blockerUserId == request.auth.uid;
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly(['blockerUserId', 'blockedUserId', 'createdAt'])
        && incoming().blockerUserId == request.auth.uid
        && incoming().blockedUserId is string
        && incoming().blockedUserId != request.auth.uid
        && blockId == incoming().blockerUserId + '__' + incoming().blockedUserId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUwUser()
        && resource.data.blockerUserId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Reports — write-only evidence. Immutable. No client reads.
    // ------------------------------------------------------------------

    match /reports/{reportId} {
      allow create: if isVerifiedUwUser()
        && incoming().keys().hasOnly([
             'reporterUserId', 'reportedUserId', 'reason', 'details',
             'context', 'createdAt'
           ])
        && incoming().reporterUserId == request.auth.uid
        && incoming().reportedUserId is string
        && incoming().reportedUserId != request.auth.uid
        && incoming().reason in ['Spam', 'Harassment', 'Unsafe behavior', 'Impersonation', 'Other']
        && incoming().details is string
        && incoming().details.size() <= 1000
        && incoming().context is string
        && incoming().context.size() <= 40
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Default deny.
    // ------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
